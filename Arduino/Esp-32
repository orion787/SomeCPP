static void init_interrupt_pins(void) {
    gpio_num_t pins[] = {
        GPIO_NUM_14, GPIO_NUM_15, GPIO_NUM_16, GPIO_NUM_17,
        GPIO_NUM_25, GPIO_NUM_26, GPIO_NUM_27
    };
    
    for (int i = 0; i < sizeof(pins)/sizeof(pins[0]); i++) {
        gpio_config_t io_conf = {
            .pin_bit_mask = (1ULL << pins[i]),
            .mode = GPIO_MODE_OUTPUT,
            .pull_up_en = GPIO_PULLUP_DISABLE,
            .pull_down_en = GPIO_PULLDOWN_DISABLE,
            .intr_type = GPIO_INTR_DISABLE
        };
        gpio_config(&io_conf);
        gpio_set_level(pins[i], 0);
    }
}

// ============== MAIN PROCESSING FUNCTION ==============

static void process_request(const char *key) {
    ESP_LOGI(TAG, "Processing request for key: %s", key);
    
    // Ищем данные в hash map
    hash_value_t *value = search(&data_map, (char*)key);
    if (value == NULL) {
        ESP_LOGE(TAG, "Key '%s' not found in dictionary", key);
        return;
    }
    
    ESP_LOGI(TAG, "Found entry with %d values for key '%s'", value->values_count, key);
    
    // Создаем оба slave устройства
    esp_err_t err = create_i2c_slaves(slave_addresses[0], slave_addresses[1]);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to create slaves");
        return;
    }
    
    // Обрабатываем каждый элемент данных
    for (int i = 0; i < value->values_count; i++) {
        const slave_data_t *slave_data = &value->values[i];
        
        ESP_LOGI(TAG, "Processing value %d: slave=%d, pin=%d, data_len=%d", 
                 i, slave_data->slave_num, slave_data->pin, slave_data->piece.data_len);
        
        // Симулируем прерывание на конкретном пине
        simulate_interrupt(slave_data->pin);
        
        // Отправляем данные через указанный slave
        err = send_data_via_slave(slave_data->slave_num, 
                                  slave_data->piece.data, 
                                  slave_data->piece.data_len);
        if (err != ESP_OK) {
            ESP_LOGE(TAG, "Failed to send data for value %d: %s", i, esp_err_to_name(err));
        }
        
        // Небольшая задержка между отправками
        vTaskDelay(pdMS_TO_TICKS(50));
    }
    
    // Задержка для обработки
    vTaskDelay(pdMS_TO_TICKS(100));
    
    // Удаляем оба slave устройства
    delete_i2c_slaves();
}

// ============== I2C SCAN FUNCTIONS ==============

static esp_err_t i2c_scan_address(uint8_t addr) {
    i2c_cmd_handle_t cmd = i2c_cmd_link_create();
    i2c_master_start(cmd);
    i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_WRITE, ACK_CHECK_EN);
    i2c_master_stop(cmd);
    esp_err_t err = i2c_master_cmd_begin(I2C_MASTER_NUM, cmd, pdMS_TO_TICKS(50));
    i2c_cmd_link_delete(cmd);
    return err;
}

static void i2c_scan(void) {
    ESP_LOGI(TAG, "Scanning I2C bus...");
    for (uint8_t addr = 0x01; addr < 0x7F; addr++) {
        if (i2c_scan_address(addr) == ESP_OK) {
            ESP_LOGI(TAG, "Found device at address 0x%02X", addr);
        }
    }
    ESP_LOGI(TAG, "Scan complete");
}

// ============== MAIN ==============

void app_main(void) {
    ESP_LOGI(TAG, "Starting I2C Slave Simulator with Hash Map");
    ESP_LOGI(TAG, "I2C frequency: %d Hz", I2C_MASTER_FREQ_HZ);
    
    // Инициализация I2C
    ESP_ERROR_CHECK(i2c_master_init());
    ESP_LOGI(TAG, "I2C initialized successfully");
    
    // Инициализация hash map
    init_dictionary();
    
    // Инициализация GPIO
    init_interrupt_pins();
    ESP_LOGI(TAG, "GPIO initialized");
    
    // Сканируем шину
    i2c_scan();
    
    // Тестовые запросы
    vTaskDelay(pdMS_TO_TICKS(1000));
    
    // Тест 1: sensor1 (1 значение, slave 1)
    ESP_LOGI(TAG, "=== Test 1: sensor1 ===");
    process_request("sensor1");
    vTaskDelay(pdMS_TO_TICKS(500));
    
    // Тест 2: actuator2 (4 значения, slave 2)
    ESP_LOGI(TAG, "=== Test 2: actuator2 ===");
    process_request("actuator2");
    vTaskDelay(pdMS_TO_TICKS(500));
    
    // Тест 3: sensor2 (2 значения, slave 2)
    ESP_LOGI(TAG, "=== Test 3: sensor2 ===");
    process_request("sensor2");
    vTaskDelay(pdMS_TO_TICKS(500));
    
    // Тест 4: actuator1 (3 значения, slave 1)
    ESP_LOGI(TAG, "=== Test 4: actuator1 ===");
    process_request("actuator1");
    vTaskDelay(pdMS_TO_TICKS(500));
    
    // Тест 5: несуществующий ключ
    ESP_LOGI(TAG, "=== Test 5: unknown key ===");
    process_request("unknown_key");
    
    ESP_LOGI(TAG, "Demo completed");
}
