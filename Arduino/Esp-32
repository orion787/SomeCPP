#include "esp_log.h"

#define I2C_MASTER_NUM           I2C_NUM_0
#define I2C_MASTER_SDA_IO        21
#define I2C_MASTER_SCL_IO        22
#define I2C_MASTER_FREQ_HZ       400000  // 400 кГц
#define I2C_MASTER_TX_BUF_DISABLE 0
#define I2C_MASTER_RX_BUF_DISABLE 0
#define I2C_TIMEOUT_MS           100

#define I2C_SLAVE_ADDR_1         0x30
#define I2C_SLAVE_ADDR_2         0x31

#define MAX_DATA_SIZE            32
#define MAX_VALUES_PER_KEY       10
#define ACK_CHECK_EN             0x1
#define ACK_VAL                  0x0
#define NACK_VAL                 0x1

static const char *TAG = "I2C_SLAVE_SIM";

// Структура для одного элемента данных (один пин = один кусочек данных)
typedef struct {
    uint8_t data[MAX_DATA_SIZE]; // Данные для отправки
    size_t data_len;             // Длина данных
} data_piece_t;

// Структура для slave устройства
typedef struct {
    uint8_t slave_num;           // Номер slave (1 или 2)
    gpio_num_t pin;              // Пин для этого кусочка данных
    data_piece_t piece;          // Данные для этого пина
} slave_data_t;

// Структура значения в hash map
typedef struct {
    slave_data_t values[MAX_VALUES_PER_KEY]; // Массив значений
    int values_count;                         // Количество значений
} hash_value_t;

// ============== HASH MAP IMPLEMENTATION ==============

// Linked List node
struct node {
    char* key;
    hash_value_t* value;
    struct node* next;
};

void setNode(struct node* node, char* key, hash_value_t* value) {
    node->key = key;
    node->value = value;
    node->next = NULL;
}

struct hashMap {
    int numOfElements, capacity;
    struct node** arr;
};

void initializeHashMap(struct hashMap* mp) {
    mp->capacity = 100;
    mp->numOfElements = 0;
    mp->arr = (struct node**)malloc(sizeof(struct node*) * mp->capacity);
    
    for (int i = 0; i < mp->capacity; i++) {
        mp->arr[i] = NULL;
    }
}

int hashFunction(struct hashMap* mp, char* key) {
    int bucketIndex;
    int sum = 0, factor = 31;
    for (int i = 0; i < strlen(key); i++) {
        sum = ((sum % mp->capacity)
               + (((int)key[i]) * factor) % mp->capacity)
              % mp->capacity;
        factor = ((factor % __INT16_MAX__)
                  * (31 % __INT16_MAX__))
                 % __INT16_MAX__;
    }
    bucketIndex = sum;
    return bucketIndex;
}

void insert(struct hashMap* mp, char* key, hash_value_t* value) {
    int bucketIndex = hashFunction(mp, key);
    struct node* newNode = (struct node*)malloc(sizeof(struct node));
    setNode(newNode, key, value);
    
    if (mp->arr[bucketIndex] == NULL) {
        mp->arr[bucketIndex] = newNode;
    } else {
        newNode->next = mp->arr[bucketIndex];
        mp->arr[bucketIndex] = newNode;
    }
    mp->numOfElements++;
}

void delete(struct hashMap* mp, char* key) {
    int bucketIndex = hashFunction(mp, key);
    struct node* prevNode = NULL;
    struct node* currNode = mp->arr[bucketIndex];
    
    while (currNode != NULL) {
        if (strcmp(key, currNode->key) == 0) {
            if (currNode == mp->arr[bucketIndex]) {
                mp->arr[bucketIndex] = currNode->next;
            } else {
                prevNode->next = currNode->next;
            }
            free(currNode->key);
            free(currNode->value);
            free(currNode);
            mp->numOfElements--;
            break;
        }
        prevNode = currNode;
        currNode = currNode->next;
    }
}

hash_value_t* search(struct hashMap* mp, char* key) {
    int bucketIndex = hashFunction(mp, key);
    struct node* bucketHead = mp->arr[bucketIndex];
    
    while (bucketHead != NULL) {
        if (strcmp(bucketHead->key, key) == 0) {
            return bucketHead->value;
        }
        bucketHead = bucketHead->next;
    }
    
    return NULL;
}

// ============== I2C SLAVE STRUCTURES ==============

// Массив адресов для slave устройств
static const uint8_t slave_addresses[2] = {
    I2C_SLAVE_ADDR_1,  // Slave 1
    I2C_SLAVE_ADDR_2   // Slave 2
};

static struct hashMap data_map;

// ============== I2C FUNCTIONS ==============

static esp_err_t i2c_master_init(void) {
    i2c_config_t conf = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_MASTER_SDA_IO,
        .scl_io_num = I2C_MASTER_SCL_IO,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = I2C_MASTER_FREQ_HZ,
    };
    
    esp_err_t err = i2c_param_config(I2C_MASTER_NUM, &conf);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C param config failed: %s", esp_err_to_name(err));
        return err;
    }
    
    err = i2c_driver_install(I2C_MASTER_NUM, conf.mode, 
                              I2C_MASTER_TX_BUF_DISABLE, 
                              I2C_MASTER_RX_BUF_DISABLE, 0);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C driver install failed: %s", esp_err_to_name(err));
        return err;
    }
    
    return ESP_OK;
}

// Функция создания двух I2C slave устройств
static esp_err_t create_i2c_slaves(uint8_t addr1, uint8_t addr2) {
    // Проверяем, что адреса не совпадают
    if (addr1 == addr2) {
        ESP_LOGE(TAG, "Slave addresses must be different");
        return ESP_FAIL;
    }
    
    // Проверяем, что адреса валидны (7-bit I2C адреса)
    if (addr1 > 0x7F || addr2 > 0x7F) {
        ESP_LOGE(TAG, "Invalid I2C address (must be 0x00-0x7F)");
        return ESP_FAIL;
    }
    
    // В ESP32 нет явного создания I2C slave, 
    // просто логируем создание
    ESP_LOGI(TAG, "Created I2C slave 1 at address 0x%02X", addr1);
    ESP_LOGI(TAG, "Created I2C slave 2 at address 0x%02X", addr2);
    
    return ESP_OK;
}

// Функция удаления обоих I2C slave устройств
static esp_err_t delete_i2c_slaves(void) {
    // В ESP32 нет явного удаления I2C slave,
    // просто логируем удаление
    ESP_LOGI(TAG, "Deleted I2C slave 1 at address 0x%02X", slave_addresses[0]);
    ESP_LOGI(TAG, "Deleted I2C slave 2 at address 0x%02X", slave_addresses[1]);
    
    return ESP_OK;
}

static void simulate_interrupt(gpio_num_t pin) {
    gpio_set_level(pin, 1);
    vTaskDelay(pdMS_TO_TICKS(10));
    gpio_set_level(pin, 0);
    ESP_LOGI(TAG, "Interrupt simulated on GPIO %d", pin);
}

// Функция отправки данных через указанный slave
static esp_err_t send_data_via_slave(uint8_t slave_num, uint8_t *data, size_t len) {
    if (len > MAX_DATA_SIZE) {
        ESP_LOGE(TAG, "Data too large for transmission");
        return ESP_FAIL;
    }
    
    // Проверяем, что номер slave валиден (1 или 2)
    if (slave_num != 1 && slave_num != 2) {
        ESP_LOGE(TAG, "Invalid slave number: %d (must be 1 or 2)", slave_num);
        return ESP_FAIL;
    }
    
    // Получаем адрес slave по его номеру
    uint8_t slave_addr = slave_addresses[slave_num - 1];
    
    // Создаем команду I2C для записи
    i2c_cmd_handle_t cmd = i2c_cmd_link_create();
    
    // Начало транзакции
    esp_err_t err = i2c_master_start(cmd);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C start failed");
        i2c_cmd_link_delete(cmd);
        return err;
    }
    
    // Отправляем адрес slave с битом записи (0)
    err = i2c_master_write_byte(cmd, (slave_addr << 1) | I2C_MASTER_WRITE, ACK_CHECK_EN);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C write slave address failed");
        i2c_cmd_link_delete(cmd);
        return err;
    }
    
    // Отправляем данные
    ESP_LOGI(TAG, "Sending %d bytes via slave %d (addr: 0x%02X):", len, slave_num, slave_addr);
    for (int i = 0; i < len; i++) {
        err = i2c_master_write_byte(cmd, data[i], ACK_CHECK_EN);
        if (err != ESP_OK) {
            ESP_LOGE(TAG, "I2C write byte %d failed", i);
            i2c_cmd_link_delete(cmd);
            return err;
        }
        printf("0x%02X ", data[i]);
    }
    printf("\n");
    
    // Завершение транзакции
    err = i2c_master_stop(cmd);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C stop failed");
        i2c_cmd_link_delete(cmd);
        return err;
    }
    
    // Выполняем транзакцию
    err = i2c_master_cmd_begin(I2C_MASTER_NUM, cmd, pdMS_TO_TICKS(I2C_TIMEOUT_MS));
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "I2C transaction failed: %s", esp_err_to_name(err));
        i2c_cmd_link_delete(cmd);
        return err;
    }
    
    i2c_cmd_link_delete(cmd);
    ESP_LOGI(TAG, "Data sent successfully");
    
    return ESP_OK;
}

// ============== INITIALIZATION FUNCTIONS ==============

static void add_to_hash_map(const char *key, slave_data_t *values, int count) {
    char *key_copy = strdup(key);
    
    hash_value_t *value = (hash_value_t*)malloc(sizeof(hash_value_t));
    value->values_count = count;
    
    for (int i = 0; i < count; i++) {
        memcpy(&value->values[i], &values[i], sizeof(slave_data_t));
    }
    
    insert(&data_map, key_copy, value);
}

